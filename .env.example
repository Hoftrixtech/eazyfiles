# Copy to .env.local for local development. On Hostinger, set these in the Web App environment (never commit values).

# Required in production (auth, usage tracking, accounts)
MONGODB_URI=

# Required in production (Auth.js session signing)
AUTH_SECRET=

# Auth.js canonical origin (fixes OAuth callbacks; do not use 0.0.0.0)
# Local: http://localhost:3000
# Production: https://eazyfiles.com
AUTH_URL=

# Canonical site URL (no trailing slash) — https://eazyfiles.com
NEXT_PUBLIC_SITE_URL=https://eazyfiles.com

# Google OAuth — production callback: https://eazyfiles.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — dev only when Atlas is unreachable (do NOT enable on production)
# ALLOW_LOCAL_MEMORY_FALLBACK=true

# Optional — force in-memory persistence (testing only; not for production)
# PERSISTENCE_MODE=memory

# Contact form — SMTP (required on Hostinger for /api/contact)
# Import hostinger.env.template in hPanel → Environment variables → Import .env, then redeploy.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@eazyfiles.com
# SMTP_PASS=
# SMTP_FROM=support@eazyfiles.com
# Or a single URL: SMTP_URL=smtps://user:pass@smtp.hostinger.com:465
